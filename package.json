{
  "name": "everforest-lite",
  "displayName": "Everforest Lite",
  "description": "Comfortable & Pleasant Color Scheme for Visual Studio Code",
  "version": "0.8.0",
  "publisher": "linhmtran168",
  "author": "linhmtran168 (https://github.com/linhmtran168)",
  "homepage": "https://github.com/linhmtran168/everforest-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/linhmtran168/everforest-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/linhmtran168/everforest-vscode/issues"
  },
  "license": "MIT",
  "keywords": [
    "green",
    "theme"
  ],
  "galleryBanner": {
    "color": "#2f383e",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "packageManager": "pnpm@10.33.0",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "dist/index-client.js",
  "browser": "dist/index-web.js",
  "contributes": {
    "themes": [
      {
        "label": "Everforest Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-dark.json"
      },
      {
        "label": "Everforest Light",
        "uiTheme": "vs",
        "path": "./themes/everforest-light.json"
      }
    ],
    "configuration": {
      "title": "Everforest",
      "properties": {
        "everforest.darkCursor": {
          "type": "string",
          "default": "white",
          "description": "The cursor color in the dark variant.",
          "enum": [
            "white",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ]
        },
        "everforest.lightCursor": {
          "type": "string",
          "default": "black",
          "description": "The cursor color in the light variant.",
          "enum": [
            "black",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ]
        },
        "everforest.darkSelection": {
          "type": "string",
          "default": "grey",
          "description": "The background color of selected text in the dark variant.",
          "enum": [
            "grey",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ]
        },
        "everforest.lightSelection": {
          "type": "string",
          "default": "grey",
          "description": "The background color of selected text in the light variant.",
          "enum": [
            "grey",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ]
        },
        "everforest.italicKeywords": {
          "type": "boolean",
          "default": false,
          "description": "Italicize keywords or not."
        },
        "everforest.italicComments": {
          "type": "boolean",
          "default": true,
          "description": "Italicize comments or not."
        },
        "everforest.diagnosticTextBackgroundOpacity": {
          "type": "string",
          "default": "0%",
          "markdownDescription": "The opacity of the background color of [diagnostic text](https://code.visualstudio.com/updates/v1_52#_error-background-colors).",
          "enum": [
            "0%",
            "12.5%",
            "25%",
            "37.5%",
            "50%"
          ]
        },
        "everforest.highContrast": {
          "type": "boolean",
          "default": false,
          "description": "Whether to add an additional border around items across the UI to increase the contrast."
        },
        "everforest.darkContrast": {
          "type": "string",
          "default": "medium",
          "description": "Background contrast level for the dark theme.",
          "enum": [
            "soft",
            "medium",
            "hard"
          ]
        },
        "everforest.lightContrast": {
          "type": "string",
          "default": "medium",
          "description": "Background contrast level for the light theme.",
          "enum": [
            "soft",
            "medium",
            "hard"
          ]
        },
        "everforest.darkWorkbench": {
          "type": "string",
          "default": "material",
          "description": "Workbench style for the dark theme.",
          "enum": [
            "material",
            "flat",
            "high-contrast"
          ]
        },
        "everforest.lightWorkbench": {
          "type": "string",
          "default": "material",
          "description": "Workbench style for the light theme.",
          "enum": [
            "material",
            "flat",
            "high-contrast"
          ]
        },
        "everforest.lightPalette": {
          "type": "string",
          "default": "pastel",
          "markdownDescription": "Foreground palette for the light theme. `pastel` is the soft official Everforest palette (evening / ambient light). `strong` is a darker/saturated variant (bright daylight).",
          "enum": [
            "pastel",
            "strong"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "clean": "rimraf dist *.vsix",
    "compile:ts": "tsc",
    "compile:themes": "node dist/hook/generateThemes.js",
    "compile": "pnpm run clean && pnpm run compile:ts && pnpm run compile:themes",
    "validate:themes": "pnpm run compile && node scripts/validate-theme-output.cjs",
    "package": "node scripts/run-with-clean-npm-env.cjs vsce package && git checkout -- themes",
    "lint": "eslint src/",
    "browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.{json,md}": "prettier --write"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vscode/test-web": "^0.0.78",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
